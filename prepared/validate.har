          "content": {
            "size": 8336,
            "mimeType": "text/html; charset=utf-8",
            "compression": 0,
            "text": "<html>\n<head>\n    <meta charset=\"utf-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, shrink-to-fit=no\">\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\" />\n\n    \n<link rel=\"stylesheet\" href=\"/public/assets/bootstrap/dist/css/bootstrap.min.css?v=51\" type=\"text/css\">\n<link rel=\"stylesheet\" href=\"/public/themes/style_light.css?v=51\" type=\"text/css\">\n<link rel=\"stylesheet\" href=\"/public/assets/jquery-ui-themes/themes/ui-darkness/jquery-ui.min.css?v=51\" type=\"text/css\">\n<link rel=\"stylesheet\" href=\"/public/assets/font-awesome/css/font-awesome.min.css?v=51\" type=\"text/css\">\n\n<script type=\"text/javascript\" src=\"/public/assets/jquery/dist/jquery.min.js?v=51\"></script>\n<script type=\"text/javascript\" src=\"/public/assets/bootstrap/dist/js/bootstrap.min.js?v=51\"></script>\n<script type=\"text/javascript\" src=\"/public/assets/jquery-ui/jquery-ui.min.js?v=51\"></script>\n<script type=\"text/javascript\" src=\"/library/textformat.js?v=51\"></script>\n<script type=\"text/javascript\" src=\"/library/dialog.js?v=51\"></script>\n<script type=\"text/javascript\" src=\"/library/js/userDebug.js?v=51\"></script>\n\n\n    <title>OpenEMR Login</title>\n\n    <link rel=\"stylesheet\" href=\"../themes/login.css?v=51\" type=\"text/css\">\n\n    <link rel=\"shortcut icon\" href=\"/public/images/favicon.ico\" />\n\n    <script type=\"text/javascript\">\n        var registrationTranslations = {\"title\":\"OpenEMR Product Registration\",\"pleaseProvideValidEmail\":\"Please provide a valid email address\",\"success\":\"Success\",\"registeredSuccess\":\"Your installation of OpenEMR has been registered\",\"submit\":\"Submit\",\"noThanks\":\"No Thanks\",\"registeredEmail\":\"Registered email\",\"registeredId\":\"Registered id\",\"genericError\":\"Error. Try again later\",\"closeTooltip\":\"\"};\n\n        var registrationConstants = {\"webroot\":\"\"};\n    </script>\n\n    <script type=\"text/javascript\" src=\"/interface/product_registration/product_registration_service.js?v=51\"></script>\n    <script type=\"text/javascript\" src=\"/interface/product_registration/product_registration_controller.js?v=51\"></script>\n\n    <script type=\"text/javascript\">\n        jQuery(document).ready(function () {\n            init();\n\n            var productRegistrationController = new ProductRegistrationController();\n            productRegistrationController.getProductRegistrationStatus(function (err, data) {\n                if (err) {\n                    return;\n                }\n\n                if (data.statusAsString === 'UNREGISTERED') {\n                    productRegistrationController.showProductRegistrationModal();\n                }\n            });\n        });\n\n        function init() {\n            $(\"#authUser\").focus();\n        }\n\n        function transmit_form(element) {\n            // disable submit button to insert a notification of working\n            element.disabled = true;\n            // nothing fancy. mainly for mobile.\n            element.innerHTML = '<i class=\"fa fa-refresh fa-spin\"></i> Authenticating';\n                            // Delete the session cookie by setting its expiration date in the past.\n                // This forces the server to create a new session ID.\n                var olddate = new Date();\n                olddate.setFullYear(olddate.getFullYear() - 1);\n                document.cookie = \"OpenEMR\" + '=' + \"zCRfkZjJiwfySJmfHNZ7ahrAFqGPqAUrn0DliN0ghRIGMlxh\" + '; path=/; expires=' + olddate.toGMTString();\n                        document.forms[0].submit();\n        }\n    </script>\n\n</head>\n<body class=\"login\">\n    <div class=\"container\">\n        <form method=\"POST\" id=\"login_form\" autocomplete=\"off\"\n            action=\"../main/main_screen.php?auth=login&site=default\" target=\"_top\" name=\"login_form\">\n            <div class=\"row\">\n                <div class=\"col-sm-12\">\n                    <div>\n                        <div class=\"center-block\" style=\"max-width:400px\">\n                            <img class=\"img-fluid img-responsive center-block\" src=\"/public/images/login-logo.png\" />\n                        </div>\n\n                        <input type='hidden' name='new_login_session_management' value='1' />\n\n                        <input type='hidden' name='authProvider' value='Default' />\n                    </div>\n                </div>\n            </div>\n            <div class=\"row\">\n                <div class=\"col-sm-12\">\n                                    </div>\n            </div>\n            <div class=\"row\">\n                                                <div class=\"col-sm-12\">\n                    <div class=\"row\">\n                        <div class=\"center-block login-title-label\">\n                                                    </div>\n                                            </div>\n                                        <div class=\"form-group\">\n                        <label for=\"authUser\" class=\"control-label text-right\">Username:</label>\n                        <input type=\"text\" class=\"form-control\" id=\"authUser\" name=\"authUser\" placeholder=\"Username:\">\n                    </div>\n                    <div class=\"form-group\">\n                        <label for=\"clearPass\" class=\"control-label text-right\">Password:</label>\n                        <input type=\"password\" class=\"form-control\" id=\"clearPass\" name=\"clearPass\" placeholder=\"Password:\">\n                    </div>\n                                                                <div class=\"form-group\">\n                            <label for=\"language\" class=\"control-label text-right\">Language:</label>\n                            <div>\n                                <select class=\"form-control\" name=\"languageChoice\" size=\"1\">\n                                    <option selected='selected' value='1'>Default - English (Standard)</option>\n<option value='27'>Albanian</option>\n<option value='19'>Arabic</option>\n<option value='13'>Armenian</option>\n<option value='14'>Bahasa Indonesia</option>\n<option value='10'>Chinese (Simplified)</option>\n<option value='11'>Chinese (Traditional)</option>\n<option value='28'>Czech</option>\n<option value='20'>Danish</option>\n<option value='6'>Dutch</option>\n<option value='16'>English (Indian)</option>\n<option value='1'>English (Standard)</option>\n<option value='32'>Finnish</option>\n<option value='9'>French (Canadian)</option>\n<option value='8'>French (Standard)</option>\n<option value='5'>German</option>\n<option value='15'>Greek</option>\n<option value='7'>Hebrew</option>\n<option value='24'>Hindi</option>\n<option value='23'>Italian</option>\n<option value='31'>Japanese</option>\n<option value='33'>Marathi</option>\n<option value='30'>Persian</option>\n<option value='22'>Polish</option>\n<option value='18'>Portuguese (Brazilian)</option>\n<option value='17'>Portuguese (European)</option>\n<option value='25'>Romanian</option>\n<option value='12'>Russian</option>\n<option value='4'>Spanish (Latin American)</option>\n<option value='3'>Spanish (Spain)</option>\n<option value='2'>Swedish</option>\n<option value='34'>Tamil</option>\n<option value='21'>Turkish</option>\n<option value='29'>Ukrainian</option>\n<option value='26'>Vietnamese</option>\n                                </select>\n                            </div>\n                        </div>\n                                                            <div class=\"form-group pull-right\">\n                        <button type=\"submit\" class=\"btn btn-default btn-lg\" onClick=\"transmit_form(this)\"><i class=\"fa fa-sign-in\"></i>&nbsp;&nbsp;Login</button>\n                    </div>\n                </div>\n            </div>\n            <div class=\"row\">\n                <div class=\"col-sm-12 text-center\">\n                    <p class=\"small\">\n                        <a href=\"../../acknowledge_license_cert.html\" target=\"main\">Acknowledgments, Licensing and Certification</a>\n                    </p>\n                </div>\n                <div class=\"product-registration-modal\" style=\"display: none\">\n                    <p class=\"context\">Register your installation with OEMR to receive important notifications, such as security fixes and new release announcements.</p>\n                    <input placeholder=\"email\" type=\"email\" class=\"email\" style=\"width: 100%; color: black\" />\n                    <p class=\"message\" style=\"font-style: italic\"></p>\n                </div>\n            </div>\n        </form>\n    </div>\n</body>\n</html>\n"
