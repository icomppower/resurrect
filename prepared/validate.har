            { "name": "Connection", "value": "Keep-Alive" },
            { "name": "Content-Length", "value": "8781" },
            { "name": "Content-Type", "value": "text/css" },
            { "name": "Date", "value": "Sat, 07 Nov 2026 06:53:53 GMT" },
            { "name": "Keep-Alive", "value": "timeout=5, max=88" },
