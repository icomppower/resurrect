\"submit\">Mark as Cleared</button>\n                    <button class=\"btn btn-default btn-undo\" data-open-popup=\"true\" name=\"bn_reopen\"\n                            title=\"Mark as not billed\"\n                            type=\"submit\">Re-Open</button>\n                </div>\n                <div class=\"input-group\">\n                    <label for=\"left_margin\">CMS 1500 Margins Left:</label>\n                    <input type='text' size='2' id='left_margin' name='left_margin'\n                           value='24'\n                           title='HCFA left margin in points'/>\n                    <label for=\"top_margin\">Top:</label>\n                    <input type='text' size='2' id='top_margin' name='top_margin'\n                           value='20'\n                           title='HCFA top margin in points'/>\n                </div>\n                            </div>\n            <input name='mode' type='hidden' value=\"bill\">\n            <input name='authorized' type='hidden' value=\"\">\n            <input name='unbilled' type='hidden' value=\"on\">\n            <input name='code_type' type='hidden' value=\"%\">\n            <input name='to_date' type='hidden' value=\"\">\n            <input name='from_date' type='hidden' value=\"2026-11-07\">\n                                    <div class=\"table-responsive\">\n                <table class=\"table table-condensed\">\n                                                <tr>\n                            <td colspan='9' align=\"right\">\n                                <table width=\"250\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\n                                    <tr>\n                                        <td width=\"100\" id='ExpandAll'><a\n                                                onclick=\"expandcollapse('expand');\" class='small'\n                                                href=\"JavaScript:void(0);\">(Expand All)</a>\n                                        </