          "url": "http://localhost:8502/interface/main/dated_reminders/dated_reminders.php",
          "httpVersion": "HTTP/1.1",
          "cookies": [
            {
              "name": "OpenEMR",
              "value": "ukejLcXqZlC7erdnPCbKxFfMThODOj3swSXXffaAPGDxr6Uv"
            }
          ],
          "headers": [
            { "name": "Accept", "value": "*/*" },
            { "name": "Accept-Encoding", "value": "gzip, deflate, br, zstd" },
            { "name": "Connection", "value": "keep-alive" },
