          "content": {
            "size": 2326,
            "mimeType": "text/css",
            "compression": 0,
            "text": "/**\n * bootstrap_navbar.css\n *\n * @package MedEx\n * @author MedEx <support@MedExBank.com>\n * @link http://www.MedExBank.com\n * @copyright Copyright (c) 2018 MedEx <support@MedExBank.com>\n * @license https://github.com/openemr/openemr/blob/master/LICENSE GNU General Public License 3\n */\n\n.little_image { width:20px; }\n.navbar { height: 22px; z-index:1100;}\n.navbar-fixed-top {\n    background-color: #C9DBF2;\npadding: 0px;\nborder-bottom: 0.1pt solid #7b777760;\n-moz-box-shadow: 0 0 10px #000;\n-webkit-box-shadow: 0 0 10px #000;\nbox-shadow: 0 0 10px #7b777760;\nz-index: 1000;\n}\n\n.navbar-custom {\n    padding:0px;\n    color:black;\n}\n\n.navbar-nav > li > a {\n    color:black; /* just changes the base font color */\n    padding-top:6px;\n    padding-left:10px;\n    padding-right: 20px;\n    padding-bottom: 5px;\n}\n.navbar-nav > li .open > a {\n    color: #fff !important;\n    background-color: #1C5ECF !important;\n}\n.nav .navbar-right:last-child > li{\n    margin-right:20px;\n    margin-left:20px;\n}\n.nav > li > a:focus, .nav > li:focus {\n    text-decoration: none;\n    background-color: #1C5ECF; /* this is the \"hover\" blue */\n    color:#fff; /*#33aa33; <--- this is kelly green */\n}\n.nav > .active > a, .navbar-nav > .open > a {\n    color: white  !important;\n    background-color:#1C5ECF  !important; /* Mac Menu title bar background color */\n}\n\n.dropdown-menu {\n    background-color:#dee9f7; /* Mac Menu dropdown bar background color */\n}\n\n.dropdown-menu > li > a:hover, .dropdown-menu > li > a:focus {\n    color: #fff; /*#262626;*/\n    text-decoration: none;\n    background-color: #1C5ECF; /*#3E76C2;*/\n    text-shadow: none;\n}\n.navbar-brand {\n    color:black;\n    height:24px;\n    padding:10 5 0 10;\n    margin: 10px 0px 2px 0px;\n}\n\nli.open > a:first {\n    color:#fff  !important;\n}\n.navbar-nav > li > .dropdown .open {\n    margin-top: 1px;\n    background-color:red;\n}\n.dropdown-menu .divider {\n    height: 1px;\n    margin: 9px 0px;\n    Xoverflow: hidden;\n    background-color: #C0C0C0; /*gba(131, 135, 146, 0.61);*/\n}\n.navbar-toggle {\n    /* this is the responsive view shown when the screen is very narrow\n    background-color:yellow;\n    height:24px;\n    */\n}\na:hover, a:focus {\n    text-decoration:none;\n}\n\n.Xnavbar-nav > li > a:hover {\n\tcolor: #ffffff;\n}\n.dropdown {\n\tmargin-bottom: 0px;\n\tpadding: 1px;\n    list-style:none;\n}\n"
          },
