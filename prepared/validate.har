s 2 or Ins 3                            </div>                    </div>\n                </div>\n                                                        <div class=\"form-group col-xs-6\" id=\"table_billing.x12_partner_id\" style=\"display:none\">\n                    <div class= \"col-xs-12\">\n                        <label class=\"control-label\" for=\"query_drop_down_master_billing_x12_partner_id\">X12 Partner:</label>\n                        <select  name=\"query_drop_down_master_billing_x12_partner_id\"\n                        id=\"query_drop_down_master_billing_x12_partner_id\" onchange=\"appendOptionRadioCriteria(\n                        &quot;X12 Partner&quot;,\n                        &quot;billing.x12_partner_id&quot;,this.options[this.selectedIndex].text,\n                        this.options[this.selectedIndex].value,' = ',\n                        &quot;query_drop_down&quot;)\">\n                            <option value=\"all\" >All</option>\n                                                            <option value=\"1\" >Spike Clearinghouse</option>\n                                                        </select>\n                    </div>\n                </div>\n                                                                                                                    <div class=\"form-group col-xs-6\" id=\"table_billing.user\" style=\"display:none\">\n                    <div class= \"col-xs-12\">\n                        <label class=\"control-label\" for=\"text_master_billing_user\">User:</label>\n                        <input type=\"text\"  name=\"text_master_billing_user\"\n                          id=\"text_master_billing_user\" value=\"\"\n                        onkeyup=\"appendOptionTextCriteria(&quot;User&quot;,\n                        &quot;billing.user&quot;,this.value,this.value,&quot; = &quot;,\n                        &quot;text&quot;)\"\n                        onchange=\"appendOptionTextCriteria(&quot;User&quot;,\