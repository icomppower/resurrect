            "text": "<!DOCTYPE html>\n<html>\n<head>\n    <title>Calendar</title>\n    <style>\n        iframe {\n            -webkit-overflow-scrolling:touch\n            display: table;\n            empty-cells: show;\n            border-collapse: collapse;\n            border: 0;\n            width: 1px;\n            min-width: 100%;\n            min-height: 100%;\n            height: 100%;\n        }\n        body {\n            overflow:hidden;\n            -webkit-overflow-scrolling:touch;\n            margin: 0;\n            padding: 0;\n            min-width: 100%;\n            min-height: 100%;\n            width: 100%;\n            height: 100vh;\n        }\n    </style>\n</head>\n<body>\n    <iframe name=\"Calendar\" src=\"calendar/index.php?module=PostCalendar&viewtype=day&func=view&pc_username=admin\" allowfullscreen></iframe>\n</body>\n</html>\n"
